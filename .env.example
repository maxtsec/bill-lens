# Local development only. Compose reads this file; Python reads environment variables.
POSTGRES_USER=bill_lens
POSTGRES_PASSWORD=bill_lens_local_only
POSTGRES_DB=bill_lens
POSTGRES_PORT=55432
DATABASE_URL=postgresql+psycopg://bill_lens:bill_lens_local_only@127.0.0.1:55432/bill_lens
# Tests create/drop only a unique test schema in this local database.
TEST_DATABASE_URL=postgresql+psycopg://bill_lens:bill_lens_local_only@127.0.0.1:55432/bill_lens
# Relative to the working directory; start the local API from the repo root.
BILL_STORAGE_ROOT=var/uploads
BILL_DATASET_ROOT=dataset
# Real extraction is opt-in. Set secrets only in your ignored .env or process environment.
BILL_EXTRACTOR=fake
OPENAI_MODEL=
OPENAI_API_KEY=
# Manual, paid smoke check only; do not enable for the normal test suite.
BILL_LENS_LIVE=0
